# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# ---------- Database (PostGIS) ----------
POSTGRES_USER=cc
POSTGRES_PASSWORD=cc_dev_password
POSTGRES_DB=community_connect

# ---------- Supabase (Auth + Storage) ----------
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Only for projects still on the legacy HS256 JWT secret. Projects using
# asymmetric signing keys are verified via the JWKS endpoint automatically.
SUPABASE_JWT_SECRET=

# ---------- API ----------
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Browser -> API
NEXT_PUBLIC_API_URL=http://localhost:8000
# Next.js server -> API (inside the docker network)
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Claude (Phase 2) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---------- Stripe (Phase 7) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
